# ==========================================
# Shoes4Us E-Commerce Platform - Root Environment Template
# Duplicate this file to .env and customize secrets before running docker compose
# ==========================================

# ------------------------------------------
# Ports & Routing
# ------------------------------------------
FRONTEND_PORT=80
DB_PORT=5432

# ------------------------------------------
# PostgreSQL Database (Docker Service or External Managed Postgres)
# ------------------------------------------
POSTGRES_DB=shoes4us_db
POSTGRES_USER=shoes4us
POSTGRES_PASSWORD=replace_with_a_secure_database_password_123

# External Database URL (e.g. Supabase / Neon / AWS RDS)
# If using docker-compose, this is automatically constructed using db service hostname
# DATABASE_URL=postgresql://user:password@host:5432/shoes4us_db?sslmode=require

# ------------------------------------------
# JWT Authentication
# ------------------------------------------
# Generate a strong 32+ character random string in production (e.g.: openssl rand -hex 32)
JWT_SECRET=replace_with_a_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_HOURS=168

# ------------------------------------------
# Frontend & CORS
# ------------------------------------------
FRONTEND_URL=http://localhost
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5173

# ------------------------------------------
# Email Service / SMTP (Password Reset)
# ------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Shoes4Us <noreply@shoes4us.com>"
