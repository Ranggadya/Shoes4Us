{
  "name": "shoes4us-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Shoes4Us E-Commerce Platform - Monorepo (React Frontend & Go Backend)",
  "scripts": {
    "dev:fe": "npm --prefix frontend run dev",
    "build:fe": "npm --prefix frontend run build",
    "preview:fe": "npm --prefix frontend run preview",
    "lint:fe": "npm --prefix frontend run lint",
    "dev:be": "cd backend && go run ./cmd/api",
    "build:be": "cd backend && go build -o bin/shoes4us-api.exe ./cmd/api",
    "seed:be": "cd backend && go run ./cmd/seed",
    "test:be": "cd backend && go test -v ./..."
  },
  "keywords": [
    "ecommerce",
    "shoes4us",
    "react",
    "vite",
    "golang"
  ],
  "author": "Shoes4Us",
  "license": "MIT"
}
