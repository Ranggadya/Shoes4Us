# Server Configuration
PORT=8080
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
UPLOAD_DIR=./uploads

# PostgreSQL Database (Supabase / Local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shoes4us?sslmode=disable"

# JWT Authentication
JWT_SECRET="shoes4us-dev-secret-change-in-prod"
JWT_EXPIRES_HOURS=168

# Optional SMTP Configuration (Forgot Password Email)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Shoes4Us <noreply@shoes4us.com>"


# Cloudflare R2 Object Storage (Product Images)
CF_R2_ACCOUNT_ID=
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_BUCKET_NAME=shoes4us-images
CF_R2_PUBLIC_URL=https://pub-xxxx.r2.dev
